# Store text in the repository with LF, so checkouts are consistent across platforms.
* text=auto eol=lf

# Windows batch files must keep CRLF or cmd.exe can mis-parse them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly binary — never let git touch the bytes.
*.npz  binary
*.tif  binary
*.gpkg binary
*.pbf  binary
*.png  binary
*.pdf  binary
*.docx binary
*.xlsx binary
